#!/usr/bin/env bash
# Ziro CLI — the single entry point for install/update/doctor.
# This script is symlinked to ~/.local/bin/ziro during installation.
set -euo pipefail

REPO_URL="https://github.com/Pakrohk-DotFiles/ziro-shell.git"

# --- Locate Python 3 ---
PYTHON=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && \
       "$candidate" -c 'import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)' 2>/dev/null; then
        PYTHON="$candidate"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "error: Python 3 is required. Install python3 and retry." >&2
    exit 1
fi

# --- Locate the engine (ziro/) ---
# 1. Resolve from this script's real location (follow symlinks so
#    ~/.local/bin/ziro -> ~/.ziro/ziro-cli works from any cwd).
SELF="${BASH_SOURCE[0]:-$0}"
while [ -L "$SELF" ]; do
    LINK_TARGET="$(readlink "$SELF")"
    case "$LINK_TARGET" in
        /*) SELF="$LINK_TARGET" ;;
        *)  SELF="$(dirname -- "$SELF")/$LINK_TARGET" ;;
    esac
done
SCRIPT_DIR="$(cd -- "$(dirname -- "$SELF")" && pwd -P)"

# 2. The engine lives next to this script in the repo root.
if [ -d "$SCRIPT_DIR/ziro" ]; then
    exec "$PYTHON" "$SCRIPT_DIR/ziro/" "$@"
fi

# 3. Fallback: try git rev-parse (user is inside a checkout)
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    exec "$PYTHON" "$(git rev-parse --show-toplevel)/ziro/" "$@"
fi

# 4. Not found — print helpful message
echo "error: Ziro engine (ziro/) not found." >&2
echo "  Run from the Ziro repository, or install first:" >&2
echo "    curl -fsSL https://raw.githubusercontent.com/Pakrohk-DotFiles/ziro-shell/refs/heads/main/install.sh | bash" >&2
exit 1
