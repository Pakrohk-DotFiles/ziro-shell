# ~/.ziro/.zshrc.local — machine-specific settings (NOT tracked by git)
# Copy this file to .zshrc.local and edit freely.

# Machine type: 'desktop' or 'server' (set automatically by ziro install)
export ZSH_ENV_TYPE='desktop'
export EDITOR='nvim'
export BROWSER='echo'
export TERMINAL='xterm'

# Lazy-load completions (only if the tool is installed)
if (( $+commands[rustup] )); then
    znap fpath _rustup 'rustup completions zsh'
    znap fpath _cargo 'rustup completions zsh cargo'
fi

# Language tooling (set by ziro install; edit freely)
export ENABLE_PYTHON='yes'
export ENABLE_RUST='yes'
export ENABLE_GO='no'
export ENABLE_NODE='yes'
