# ~/.prompt.local
# Starship prompt bootstrap via znap.
# Starship is installed by the system package manager (pacman/brew/apt/...);
# this file only loads it into the shell. No curl installer — avoids
# duplicate binaries in ~/.local/bin that shadow the system package.
# Source this from ~/.zshrc: [ -f ~/.prompt.local ] && source ~/.prompt.local

# Load Starship with znap eval (caches output for speed)
znap eval starship 'starship init zsh --print-full-init'

# starship.toml: ziro install copies the repo's static config to
# ~/.config/starship.toml on first install only. Edit that file freely;
# ziro never overwrites it.

